---
import "../styles/styles.css";
import { LEVELS } from "../scripts/game/levels";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Spongebot</title>
    <meta
      name="description"
      content="Spongebot: a sponge robot absorbs water and electricity to solve three toybox puzzles."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="shell">
      <nav class="sidebar" aria-label="Primary">
        <h1 class="brand">Spongebot</h1>
        <p class="blurb">
          A sponge robot in a toybox. Absorb water to get heavy, absorb
          electricity to get charged &mdash; but only one at a time.
        </p>

        <section class="panel">
          <ol id="level-list" class="levels">
            {
              LEVELS.map((level, i) => (
                <li class="level" data-level={i}>
                  <button class="level-button">
                    <span class="level-mark" aria-hidden="true"></span>
                    <span class="level-text">
                      <span class="level-n">Level {i + 1}</span>
                      <span class="level-name">{level.name}</span>
                    </span>
                  </button>
                </li>
              ))
            }
          </ol>
        </section>

        <ul class="keys">
          <li><span>Arrows</span> move</li>
          <li><span>Space</span> jump</li>
        </ul>
        <p class="tally"><span id="tally">0 / 3</span> levels done</p>
      </nav>

      <main class="stage">
        <div class="screen">
          <canvas id="game" width="256" height="144"></canvas>
          <div id="overlay" class="overlay">
            <button id="play" class="primary">Play</button>
            <button id="replay" class="primary replay" hidden>Replay</button>
          </div>
        </div>
      </main>
    </div>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
